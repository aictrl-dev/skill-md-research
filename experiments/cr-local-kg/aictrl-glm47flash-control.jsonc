{
  // aictrl config for the CONTROL condition using Zhipu GLM-4.7-flash (no KG MCP).
  // Flash variant likely has no built-in reasoning mode — temperature only.
  //
  // Usage:
  //   run-aictrl.sh --condition control --rep 1 \
  //     --model zhipuai/glm-4.7-flash \
  //     --config $PWD/aictrl-glm47flash-control.jsonc
  "$schema": "https://aictrl.dev/config.json",
  "mcp": { "aictrl": { "enabled": false } },
  "provider": {
    "zhipuai": {
      "models": {
        "glm-4.7-flash": {
          "options": { "temperature": 0.7 }
        }
      }
    }
  },
  // control uses isolated skills dir: code-review only, no explore-context
  "skills": {
    "paths": ["/home/bulat/code/skill-md-research/experiments/cr-local-kg/runtime-skills-control"]
  }
}
