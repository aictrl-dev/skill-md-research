{
  // aictrl CLI config for the CONTROL condition (NO KG MCP): local gemma via
  // ollama (thinking OFF via reasoningEffort:none) + the explore-context /
  // code-review skills, but the aictrl KG MCP is explicitly DISABLED so the
  // reviewer has no query_context tool. NOTE: AICTRL_CONFIG merges with the
  // user's global aictrl config, which defines the aictrl MCP — so we must set
  // enabled:false here to suppress the inherited MCP (omitting it is NOT enough).
  "$schema": "https://aictrl.dev/config.json",
  "mcp": { "aictrl": { "enabled": false } },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "gemma4:12b-cr": {
          "name": "Gemma4 12B (64k ctx, review)",
          "tools": true,
          "options": { "temperature": 0.7, "reasoningEffort": "none" }
        }
      }
    }
  },
    "skills": {
    "paths": ["/home/bulat/code/skill-md-research/experiments/cr-local-kg/runtime-skills"]
  }
}
