{
  // aictrl config for the CONTROL condition using Zhipu GLM-4.7 (no KG MCP).
  // Uses the built-in zhipuai provider (already in aictrl's model registry).
  // Disables thinking mode to match gemma4 setup (without it GLM-4.7 uses
  // ~100× more tokens on trivial prompts via reasoning_tokens).
  //
  // Usage:
  //   run-aictrl.sh --condition control --rep 1 \
  //     --model zhipuai/glm-4.7 \
  //     --config $PWD/aictrl-glm47-control.jsonc
  "$schema": "https://aictrl.dev/config.json",
  "mcp": { "aictrl": { "enabled": false } },
  "provider": {
    "zhipuai": {
      "models": {
        "glm-4.7": {
          "options": { "temperature": 0.7, "thinking": { "type": "disabled" } }
        }
      }
    }
  },
  // control uses isolated skills dir: code-review only, no explore-context
  "skills": {
    "paths": ["/home/bulat/code/skill-md-research/experiments/cr-local-kg/runtime-skills-control"]
  }
}
