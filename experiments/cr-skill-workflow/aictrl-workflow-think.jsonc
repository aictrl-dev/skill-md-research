{
  "$schema": "https://aictrl.dev/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "gemma4:12b-cr": { "name": "Gemma4 12B (thinking)", "tools": true,
          "options": { "temperature": 0.7, "thinking": { "type": "enabled" } } }
      }
    }
  },
  "mcp": { "aictrl": { "enabled": false } }
}
